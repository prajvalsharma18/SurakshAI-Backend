# Required for JWT authentication in development and production.
APP_ENV=development
DEBUG=false
JWT_SECRET_KEY=replace-with-a-long-random-development-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_ISSUER=surakshai-api
JWT_AUDIENCE=surakshai-client
PSEUDONYMIZATION_SECRET=replace-with-a-long-random-pseudonymization-value

# Demo accounts are seeded only when explicitly enabled in development.
SURAKSHAI_ENABLE_DEV_USER_SEED=0

# Synthetic staging seed settings. Set the development-only password locally;
# it is hashed by the user service and is never printed by the seed command.
SURAKSHAI_ENABLE_SYNTHETIC_SEED=0
SURAKSHAI_SYNTHETIC_PERSONNEL_COUNT=30
SURAKSHAI_SYNTHETIC_SEED_BATCH_ID=surakshai-staging-2026-09
SYNTHETIC_DATA_RANDOM_SEED=42
SYNTHETIC_DATA_AS_OF=2026-09-28
SURAKSHAI_STAGING_PERSONNEL_PASSWORD=
SURAKSHAI_RESET_SYNTHETIC_DATA=0

# Explicit browser origins allowed to call private APIs. Production must use HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:8083,http://127.0.0.1:8083
MAX_REQUEST_SIZE_BYTES=1048576
LOGIN_RATE_LIMIT=10
ADMIN_USER_RATE_LIMIT=20
HRMS_SYNC_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# MongoDB configuration for the SIH personnel foundation.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=personnel_welfare
MONGODB_TIMEOUT_MS=3000
MONGODB_TLS=

# Optional Phase 6 OpenAI-compatible welfare recommendation provider.
# Leave unset to fail closed when grounded recommendations are requested.
SURAKSHAI_LLM_BASE_URL=
SURAKSHAI_LLM_MODEL=
SURAKSHAI_LLM_API_KEY=
SURAKSHAI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Governance placeholders. Empty means no approved deletion period and no automatic cleanup.
WELLNESS_RETENTION_DAYS=
RISK_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=
